# 复制本文件为 .env 并填写。没填的服务商也可以在网页上临时输入 Key。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Kimi
MOONSHOT_API_KEY=
# 通义千问（阿里云百炼）
DASHSCOPE_API_KEY=

# 自定义 OpenAI 兼容服务（智谱 / 中转站 / 本地 Ollama 等）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 部署到公网时务必设置访问密码，否则任何人都能用你服务器上的 Key
APP_PASSWORD=

# 监听地址：本机用 127.0.0.1；服务器部署用 0.0.0.0
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=30
