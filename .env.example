# 复制本文件为 .env 并填写。没填的服务商也可以在网页上临时输入 Key。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Kimi
MOONSHOT_API_KEY=
# 通义千问（阿里云百炼）
DASHSCOPE_API_KEY=

# 自定义 OpenAI 兼容服务（智谱 / 中转站 / 本地 Ollama 等）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 本站内置的免费额度：智谱 GLM 免费模型（在 https://open.bigmodel.cn 免费申请 Key）
# 填写后，“智谱 GLM（免费）”无需用户填 Key 即可翻译、生成术语表（只允许调用免费模型）
FREE_API_KEY=
# 防滥用：每个 IP 每天可免费翻译的字符数、全站每天总字符数、免费模型并发数
FREE_TRANSLATE_CHARS_PER_IP_DAY=100000
FREE_TRANSLATE_CHARS_PER_DAY=3000000
FREE_CONCURRENCY=2
# 术语表：每个 IP 每小时次数、全站每天总次数、单次最多分析的字符数
FREE_GLOSSARY_PER_IP_HOUR=10
FREE_GLOSSARY_PER_DAY=500
FREE_GLOSSARY_MAX_CHARS=60000

# 部署到公网时务必设置访问密码，否则任何人都能用你服务器上的 Key
APP_PASSWORD=

# 监听地址：本机用 127.0.0.1；服务器部署用 0.0.0.0
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=30
