# 复制本文件为 .env 并填写。没填的服务商也可以在网页上临时输入 Key。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Kimi
MOONSHOT_API_KEY=
# 通义千问（阿里云百炼）
DASHSCOPE_API_KEY=

# 自定义 OpenAI 兼容服务（智谱 / 中转站 / 本地 Ollama 等）
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# 自动生成术语表用的内置免费模型（默认智谱 GLM-4.7-Flash，在 https://open.bigmodel.cn 免费申请 Key）
# 填写后，网页上会出现“内置免费模型”选项，用户不填 Key 也能生成术语表
FREE_API_KEY=
# 可选：更换免费模型（任意 OpenAI 兼容接口）
# FREE_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# FREE_MODEL=glm-4.7-flash
# FREE_MODEL_LABEL=智谱 GLM-4.7-Flash
# 防滥用：每个 IP 每小时次数、全站每天总次数、单次最多分析的字符数
FREE_GLOSSARY_PER_IP_HOUR=10
FREE_GLOSSARY_PER_DAY=500
FREE_GLOSSARY_MAX_CHARS=60000

# 部署到公网时务必设置访问密码，否则任何人都能用你服务器上的 Key
APP_PASSWORD=

# 监听地址：本机用 127.0.0.1；服务器部署用 0.0.0.0
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=30
